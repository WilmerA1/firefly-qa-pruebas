<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuración de la suite SU-UN (FF3-PLAN-1). Fuerza SQLite en memoria. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="../../vendor/autoload.php"
         colors="true"
         cacheDirectory="/tmp/.phpunit.cache">
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="APP_LOG_LEVEL" value="notice" force="true"/>
        <env name="AUDIT_LOG_LEVEL" value="emergency" force="true"/>
        <env name="CACHE_DRIVER" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
    </php>
    <testsuites>
        <testsuite name="SU-UN">
            <directory suffix="Test.php">.</directory>
        </testsuite>
    </testsuites>
</phpunit>
